{
  "name": "miracle-syntax",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:miracle"
  ],
  "displayName": "Miracle Engine Material Syntax",
  "description": "Syntax highlighting for Miracle Material / template files",
  "version": "1.0.10",
  "publisher": "MiracleEngine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Logris/material-vscode.git"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "miracle",
        "aliases": [
          "MiracleMaterial"
        ],
        "extensions": [
          ".mat",
          ".template",
          ".fx"
        ],
        "firstLine": "^// Miracle Engine Material File",
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icon.svg",
          "dark": "./media/icon.svg"
        }
      }
    ],
    "snippets": [
      {
        "language": "miracle",
        "path": "./snippets/material-snippets.json"
      }
    ],
    "grammars": [
      {
        "language": "miracle",
        "scopeName": "source.miracle",
        "path": "./syntaxes/material-language.json"
      }
    ],
    "configuration": {
      "title": "Miracle Material",
      "properties": {
        "miracle.formatting.alignment": {
          "type": "string",
          "enum": [
            "block",
            "line"
          ],
          "enumDescriptions": [
            "Выравнивать значения по самому длинному имени параметра в блоке",
            "Выравнивать значения по каждому параметру отдельно"
          ],
          "default": "block",
          "markdownDescription": "Режим выравнивания значений параметров при форматировании Miracle material файлов (`.mat`, `.template`, `.fx`)."
        }
      }
    }
  }
}